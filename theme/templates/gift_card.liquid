<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <title>{{ shop.name }} — {{ 'Carte cadeau' }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@700;900&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    {{ 'kawami.css' | asset_url | stylesheet_tag }}
    {% render 'kawami-tokens' %}
    <style>body{ background:#fdf3f4; display:flex; align-items:center; justify-content:center; min-height:100vh; }</style>
  </head>
  <body>
    <div style="text-align: center; background: #fff; border-radius: 28px; padding: 48px; box-shadow: 0 14px 40px rgba(92,67,81,.16); max-width: 480px">
      <div style="font-size: 40px; margin-bottom: 12px">🎁</div>
      <h1 style="font: 900 28px var(--k-font-title); color: var(--k-text); margin: 0 0 10px">Carte cadeau Kawami</h1>
      <p style="font: 700 24px var(--k-font-ui); color: var(--k-primary); margin: 0 0 18px">{{ gift_card.initial_value | money }}</p>
      <p style="font: 600 16px var(--k-font-ui); color: var(--k-text-soft); letter-spacing: .08em">{{ gift_card.code | format_code }}</p>
      {% if gift_card.enabled and gift_card.balance > 0 %}
        <p style="font: 500 13px var(--k-font-ui); color: var(--k-text-muted)">Solde restant : {{ gift_card.balance | money }}</p>
      {% endif %}
    </div>
  </body>
</html>
