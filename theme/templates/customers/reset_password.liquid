<section class="k-container" style="padding: 48px 40px 60px; max-width: 480px">
  <h1 style="font: 900 30px var(--k-font-title); color: var(--k-text); margin: 0 0 20px; text-align: center">Nouveau mot de passe</h1>
  <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 24px; padding: 30px 32px">
    {% form 'reset_customer_password' %}
      {% if form.errors %}<p style="font: 600 13px var(--k-font-ui); color: #a94f6e; margin-bottom: 12px">{{ form.errors | default_errors }}</p>{% endif %}
      <div style="font: 700 12px var(--k-font-ui); color: var(--k-text); margin-bottom: 6px">Nouveau mot de passe</div>
      <input type="password" class="k-field" name="customer[password]" autocomplete="new-password" required style="margin-bottom: 14px">
      <div style="font: 700 12px var(--k-font-ui); color: var(--k-text); margin-bottom: 6px">Confirme le mot de passe</div>
      <input type="password" class="k-field" name="customer[password_confirmation]" autocomplete="new-password" required style="margin-bottom: 18px">
      <button type="submit" class="k-btn k-btn-primary" style="width: 100%">Enregistrer</button>
    {% endform %}
  </div>
</section>
