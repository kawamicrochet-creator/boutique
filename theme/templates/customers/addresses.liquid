<section class="k-container" style="padding: 44px 40px 60px; max-width: 760px">
  <div class="k-breadcrumb"><a href="{{ routes.account_url }}">Mon compte</a> <span style="opacity: .5">›</span> Mes adresses</div>
  <h1 style="font: 900 30px var(--k-font-title); color: var(--k-text); margin: 0 0 24px">Mes adresses</h1>

  {% form 'customer_address', customer.new_address %}
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 20px; padding: 24px 26px; margin-bottom: 24px">
      <div style="font: 700 15px var(--k-font-title); color: var(--k-text); margin-bottom: 14px">Ajouter une adresse</div>
      <div class="k-grid k-grid-2" style="margin-bottom: 12px">
        <input type="text" class="k-field" name="address[first_name]" placeholder="Prénom" value="{{ form.first_name }}">
        <input type="text" class="k-field" name="address[last_name]" placeholder="Nom" value="{{ form.last_name }}">
      </div>
      <input type="text" class="k-field" name="address[address1]" placeholder="Adresse" value="{{ form.address1 }}" style="margin-bottom: 12px">
      <input type="text" class="k-field" name="address[address2]" placeholder="Complément" value="{{ form.address2 }}" style="margin-bottom: 12px">
      <div class="k-grid k-grid-2" style="margin-bottom: 12px">
        <input type="text" class="k-field" name="address[city]" placeholder="Ville" value="{{ form.city }}">
        <input type="text" class="k-field" name="address[zip]" placeholder="Code postal" value="{{ form.zip }}">
      </div>
      <input type="text" class="k-field" name="address[country]" placeholder="Pays" value="{{ form.country }}" style="margin-bottom: 18px">
      <button type="submit" class="k-btn k-btn-primary">Enregistrer l'adresse</button>
    </div>
  {% endform %}

  {% if customer.addresses.size > 0 %}
    <div class="k-grid k-grid-2">
      {% for address in customer.addresses %}
        <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 18px; padding: 18px 20px">
          <div style="font: 500 13px/1.6 var(--k-font-ui); color: var(--k-text-soft); margin-bottom: 10px">{{ address | format_address }}</div>
          {% form 'customer_address', address %}
            <button type="submit" name="_method" value="delete" class="k-btn k-btn-secondary" onclick="return confirm('Retirer cette adresse ?')" style="font-size: 12px; padding: 8px 16px">Retirer</button>
          {% endform %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>
