{% style %}
  :root {
    --k-bg: {{ settings.color_bg }};
    --k-card: {{ settings.color_card }};
    --k-primary: {{ settings.color_primary }};
    --k-primary-hover: {{ settings.color_primary_hover }};
    --k-text: {{ settings.color_text }};
    --k-text-soft: {{ settings.color_text_soft }};
    --k-text-muted: {{ settings.color_text_muted }};
    --k-border: {{ settings.color_border }};
    --k-footer-bg: {{ settings.color_footer_bg }};
    --k-footer-text: {{ settings.color_footer_text }};
    --k-instock-bg: {{ settings.color_instock_bg }};
    --k-instock-text: {{ settings.color_instock_text }};
    --k-preorder-bg: {{ settings.color_preorder_bg }};
    --k-preorder-text: {{ settings.color_preorder_text }};
    --k-pink: #f2a9bb;
    --k-pink-soft: #f8cdd8;
    --k-lavender: #d5c3e8;
    --k-lavender-deep: #9d7fc2;
    --k-mint: #bfe3d2;
    --k-mint-deep: #7fbcab;
    --k-beige: #f6ece1;
    --k-beige-border: #ecdcc9;
    --k-beige-deep: #c9955f;
    --k-beige-darker: #8a6a45;
    --k-font-title: 'Zen Maru Gothic', sans-serif;
    --k-font-ui: 'Quicksand', sans-serif;
    --k-font-accent: 'Cormorant Garamond', serif;
  }
{% endstyle %}
