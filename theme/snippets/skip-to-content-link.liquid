{%- doc -%}
  Renders a skip to content link, visible on focus only.
  @param {string} href
  @param {string} text
{%- enddoc -%}
<a class="skip-to-content-link" href="{{ href }}">{{ text | t }}</a>
{% stylesheet %}
  .skip-to-content-link { position: absolute; left: -99999px; }
  .skip-to-content-link:focus {
    left: 16px; top: 16px; z-index: 999;
    background: #fff; color: #5c4351; padding: 12px 20px; border-radius: 999px;
    font: 700 13px Quicksand, sans-serif;
  }
{% endstylesheet %}
