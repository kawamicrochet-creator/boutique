{% doc %}
  Renders Shopify's native language/currency (market) selectors, using
  the store's actual configured languages (Translate & Adapt) and
  markets/currencies - not a fake demo dropdown.
{% enddoc %}
{% if localization.available_languages.size > 1 or localization.available_countries.size > 1 %}
  {% form 'localization', class: 'k-localization-form' %}
    {% if localization.available_languages.size > 1 %}
      <select name="locale_code" class="k-localization-select" onchange="this.form.submit()" aria-label="Langue">
        {% for language in localization.available_languages %}
          <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
            {{ language.endonym_name | capitalize }}
          </option>
        {% endfor %}
      </select>
    {% endif %}
    {% if localization.available_countries.size > 1 %}
      <select name="country_code" class="k-localization-select" onchange="this.form.submit()" aria-label="Pays / devise">
        {% for country in localization.available_countries %}
          <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
            {{ country.iso_code }} · {{ country.currency.iso_code }} {{ country.currency.symbol }}
          </option>
        {% endfor %}
      </select>
    {% endif %}
    <noscript><button type="submit" class="k-localization-submit">OK</button></noscript>
  {% endform %}
{% endif %}
