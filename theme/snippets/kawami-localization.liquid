{% doc %}
  Renders Shopify's native currency/market selector, using the store's
  actual configured markets - not a fake demo dropdown. Language is
  handled by a separate translation app, so only country/currency shows
  here.
{% enddoc %}
{% if localization.available_countries.size > 1 %}
  {% form 'localization', class: 'k-localization-form' %}
    <select name="country_code" class="k-localization-select" onchange="this.form.submit()" aria-label="Devise">
      {% for country in localization.available_countries %}
        <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
          {{ country.iso_code }} · {{ country.currency.iso_code }} {{ country.currency.symbol }}
        </option>
      {% endfor %}
    </select>
    <noscript><button type="submit" class="k-localization-submit">OK</button></noscript>
  {% endform %}
{% endif %}
