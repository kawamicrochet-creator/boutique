{% doc %}
  Renders Shopify's native currency/market selector. Language selection
  was removed - the merchant's translation app handles that separately
  (its own selector), and Shopify's native locale_code switch didn't
  work correctly for all configured languages (e.g. Spanish).
{% enddoc %}
{% if localization.available_countries.size > 1 %}
  {% form 'localization', class: 'k-localization-form' %}
    <select name="country_code" class="k-localization-select" onchange="this.form.submit()" aria-label="Devise">
      {% for country in localization.available_countries %}
        <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
          {{ country.iso_code }} · {{ country.currency.iso_code }} {{ country.currency.symbol }}
        </option>
      {% endfor %}
    </select>
    <noscript><button type="submit" class="k-localization-submit">OK</button></noscript>
  {% endform %}
{% endif %}
