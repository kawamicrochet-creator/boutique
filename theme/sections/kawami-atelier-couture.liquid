<section style="background: var(--k-beige); border-top: 1px solid var(--k-beige-border); border-bottom: 1px solid var(--k-beige-border); margin-top: 30px">
  <div class="k-container" style="padding: 56px 40px; display: grid; grid-template-columns: 1.25fr .75fr; gap: 52px; align-items: center">
    <div style="position: relative">
      <div class="k-photo-frame k-rotate-n2" style="min-height: 260px">
        {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" style="width: 100%; height: 100%; object-fit: cover" alt="">{% endif %}
      </div>
      {% if section.settings.tag_text != blank %}
        <div style="position: absolute; right: -10px; bottom: -12px; background: var(--k-beige); border: 1.5px solid var(--k-beige-border); border-radius: 999px; padding: 10px 18px; transform: rotate(2deg); box-shadow: 0 6px 16px rgba(92,67,81,.12)" class="k-italic-accent" >
          <span style="color: var(--k-beige-darker); font-size: 15px">{{ section.settings.tag_text }}</span>
        </div>
      {% endif %}
    </div>
    <div>
      <div class="k-italic-accent" style="color: #b98a63; letter-spacing: .08em; margin-bottom: 10px; font-size: 15px">{{ section.settings.eyebrow }}</div>
      <h2 style="font: 900 34px/1.2 var(--k-font-title); color: var(--k-text); margin: 0 0 16px; text-wrap: pretty">{{ section.settings.title }} <span class="k-italic-accent" style="color: var(--k-beige-deep); font-size: 38px">{{ section.settings.title_accent }}</span></h2>
      <p class="k-lead" style="font-size: 15px; margin: 0 0 22px; max-width: 440px">{{ section.settings.text }}</p>
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_url }}" style="display: inline-block; font: 700 14px var(--k-font-ui); color: var(--k-beige-darker); border: 2px solid #d9bd9c; padding: 12px 24px; border-radius: 999px">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier couture (teaser)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "tag_text", "label": "Étiquette sur la photo", "default": "cousu main, en petite série 🪡" },
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "L'atelier couture · bientôt" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Fleurs, tissus" },
    { "type": "text", "id": "title_accent", "label": "Titre (accent italique)", "default": "& romantisme" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "À côté du crochet, l'atelier propose des accessoires aux tissus fleuris : trousses de toilette, housses pour livres et ordinateurs, totes bags matelassés. Chaque pièce est cousue à la main, en petite série." },
    { "type": "text", "id": "cta_text", "label": "Bouton", "default": "Être prévenue du lancement" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Atelier couture (teaser)" }]
}
{% endschema %}
