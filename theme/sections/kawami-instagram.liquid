<section style="background: #fff; border-top: 1px solid var(--k-border)">
  <div class="k-container" style="padding: 52px 40px">
    <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 22px">
      <h2 style="font: 900 24px var(--k-font-title); color: var(--k-text); margin: 0">{{ section.settings.title | default: "En ce moment sur Instagram 📸" }}</h2>
      <div style="margin-left: auto; display: flex; gap: 16px; font: 700 13px var(--k-font-ui)">
        {% if settings.social_instagram_url != blank %}<a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener">@{{ settings.social_instagram }}</a>{% endif %}
        {% if settings.social_tiktok_url != blank %}<a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener">TikTok ↗</a>{% endif %}
      </div>
    </div>
    <div class="k-insta-grid">
      {% for block in section.blocks %}
        {% if block.type == 'photo' %}
          <a href="{{ block.settings.url | default: '#' }}" style="aspect-ratio: 1; border-radius: 14px; overflow: hidden; position: relative; display: block" {{ block.shopify_attributes }}>
            {% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 400 }}" style="width: 100%; height: 100%; object-fit: cover" alt="">{% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "En ce moment sur Instagram 📸" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "url", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
