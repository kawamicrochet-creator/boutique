<section class="k-split" style="max-width: 1000px; margin: 0 auto; padding: 52px 40px 20px; display: grid; grid-template-columns: .85fr 1.15fr; gap: 52px; align-items: center">
  <div style="position: relative">
    <div class="k-photo-frame k-rotate-n2" style="aspect-ratio: .85">
      {% if section.settings.portrait %}<img src="{{ section.settings.portrait | image_url: width: 900 }}" style="width: 100%; height: 100%; object-fit: cover" alt="">{% endif %}
    </div>
    {% if section.settings.portrait_tag != blank %}
      <div style="position: absolute; right: -8px; bottom: -12px; background: var(--k-pink-soft); border-radius: 999px; padding: 10px 18px; font: 700 12.5px var(--k-font-ui); color: var(--k-text); transform: rotate(3deg); box-shadow: 0 6px 16px rgba(92,67,81,.15)">{{ section.settings.portrait_tag }}</div>
    {% endif %}
  </div>
  <div>
    <div style="font: 700 12px var(--k-font-ui); letter-spacing: .22em; color: var(--k-text-muted); text-transform: uppercase; margin-bottom: 12px">Mon histoire</div>
    <h1 style="font: 900 40px/1.2 var(--k-font-title); color: var(--k-text); margin: 0 0 16px; text-wrap: pretty">{{ section.settings.title }}</h1>
    <p class="k-lead" style="font-size: 15px; line-height: 1.75; margin: 0 0 12px">{{ section.settings.paragraph_1 }}</p>
    <p class="k-lead" style="font-size: 15px; line-height: 1.75; margin: 0">{{ section.settings.paragraph_2 }}</p>
  </div>
</section>

<section style="max-width: 1000px; margin: 0 auto; padding: 44px 40px 10px">
  {% if section.settings.companion_name != blank %}
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 22px; padding: 24px 28px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-bottom: 22px">
      <div style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; border: 4px solid var(--k-pink-soft); flex: none">
        {% if section.settings.companion_image %}<img src="{{ section.settings.companion_image | image_url: width: 300 }}" style="width: 100%; height: 100%; object-fit: cover" alt="">{% endif %}
      </div>
      <div style="flex: 1; min-width: 260px">
        <div style="font: 700 18px var(--k-font-title); color: var(--k-text); margin-bottom: 4px">{{ section.settings.companion_name }}</div>
        <div style="font: 700 11px var(--k-font-ui); letter-spacing: .14em; text-transform: uppercase; color: var(--k-text-muted); margin-bottom: 8px">{{ section.settings.companion_role }}</div>
        <div style="font: 500 14px/1.65 var(--k-font-ui); color: var(--k-text-soft)">{{ section.settings.companion_text }}</div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.impact_text != blank %}
    <div class="k-callout" style="background: var(--k-pink-soft)">
      <div class="k-callout__icon">💕</div>
      <div style="flex: 1; min-width: 280px; font: 600 14px/1.65 var(--k-font-ui); color: var(--k-text)">{{ section.settings.impact_text }}</div>
    </div>
  {% endif %}

  <div class="k-grid k-grid-3" style="margin-top: 26px">
    {% for block in section.blocks %}
      {% if block.type == 'value' %}
        <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 22px; padding: 24px 22px" {{ block.shopify_attributes }}>
          <div style="width: 44px; height: 44px; border-radius: 50%; background: {{ block.settings.bg }}; display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 12px">{{ block.settings.icon }}</div>
          <div style="font: 700 16px var(--k-font-title); color: var(--k-text); margin-bottom: 6px">{{ block.settings.title }}</div>
          <div style="font: 500 13px/1.6 var(--k-font-ui); color: var(--k-text-soft)">{{ block.settings.text }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% if section.settings.convention_text != blank %}
<section style="max-width: 1000px; margin: 0 auto; padding: 10px 40px 56px">
  <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 26px; padding: 34px 38px; display: flex; gap: 24px; align-items: center; flex-wrap: wrap">
    <div style="font-size: 34px">⛩️</div>
    <div style="flex: 1; min-width: 280px">
      <div style="font: 700 18px var(--k-font-title); color: var(--k-text); margin-bottom: 6px">{{ section.settings.convention_title }}</div>
      <div style="font: 500 14px/1.65 var(--k-font-ui); color: var(--k-text-soft)">{{ section.settings.convention_text }}</div>
    </div>
    {% if section.settings.convention_cta_url != blank %}
      <a href="{{ section.settings.convention_cta_url }}" class="k-btn k-btn-primary">{{ section.settings.convention_cta_text | default: "Visiter la boutique" }}</a>
    {% endif %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Mon histoire",
  "settings": [
    { "type": "image_picker", "id": "portrait", "label": "Photo (portrait)" },
    { "type": "text", "id": "portrait_tag", "label": "Étiquette sur la photo", "default": "maille après maille 🎀" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Coucou, moi c'est Savie 🌸" },
    { "type": "textarea", "id": "paragraph_1", "label": "Paragraphe 1", "default": "Savie, c'est mon surnom — je m'appelle Savannah. Je suis non-binaire, à mobilité réduite et atteinte de maladies chroniques — et c'est moi qui m'occupe de Kawami. Grande fan d'animés et de k-pop, je voulais offrir des amis réconfortants inspirés de ces univers." },
    { "type": "textarea", "id": "paragraph_2", "label": "Paragraphe 2", "default": "Ma famille m'épaule pour la création et la logistique, mais Kawami, c'est mon bébé : un espace bienveillant où tout le monde est accepté et bienvenu." },
    { "type": "image_picker", "id": "companion_image", "label": "Photo du compagnon" },
    { "type": "text", "id": "companion_name", "label": "Nom du compagnon", "default": "Willow 🐾" },
    { "type": "text", "id": "companion_role", "label": "Rôle", "default": "Chienne d'assistance officielle" },
    { "type": "textarea", "id": "companion_text", "label": "Texte", "default": "Ma bouvier bernois, qui m'accompagne partout — et qui adore participer aux shootings photo des peluches." },
    { "type": "textarea", "id": "impact_text", "label": "Texte d'impact", "default": "Chaque peluche vendue contribue directement à mon confort et aux frais médicaux de mes déplacements chez les spécialistes. Merci du fond du cœur de faire vivre Kawami." },
    { "type": "text", "id": "convention_title", "label": "Titre convention", "default": "On se croisera en convention !" },
    { "type": "textarea", "id": "convention_text", "label": "Texte convention", "default": "J'adore aller en convention quand mon état de santé me le permet ! Les stands Kawami font une petite pause cette année, le temps de prendre soin de moi. Rendez-vous l'année prochaine ; en attendant, la boutique en ligne reste grande ouverte 💕" },
    { "type": "text", "id": "convention_cta_text", "label": "Bouton convention", "default": "Visiter la boutique" },
    { "type": "url", "id": "convention_cta_url", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Valeur",
      "settings": [
        { "type": "text", "id": "icon", "label": "Émoji", "default": "🎀" },
        { "type": "color", "id": "bg", "label": "Fond du rond", "default": "#f8cdd8" },
        { "type": "text", "id": "title", "label": "Titre", "default": "100 % fait main" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mon histoire",
      "blocks": [
        { "type": "value", "settings": { "icon": "🎀", "bg": "#f8cdd8", "title": "100 % fait main", "text": "Chaque peluche demande des heures de crochet. Pas deux identiques — la tienne est unique au monde." } },
        { "type": "value", "settings": { "icon": "🌿", "bg": "#bfe3d2", "title": "Matières saines", "text": "Laine chenille certifiée Oeko-Tex et rembourrage hypoallergénique." } },
        { "type": "value", "settings": { "icon": "💌", "bg": "#d5c3e8", "title": "親友, « meilleur ami »", "text": "Le slogan de Kawami : chaque peluche est pensée pour devenir le petit compagnon qu'on garde toujours près de soi." } }
      ]
    }
  ]
}
{% endschema %}
