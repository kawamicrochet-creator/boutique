<section class="k-container" style="padding: 44px 40px 60px">
  <h1 class="k-h1">Nos collections</h1>
  <div class="k-grid k-grid-4">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        <a href="{{ collection.url }}" class="k-card">
          <div class="k-card__media">{% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title }}" loading="lazy">{% endif %}</div>
          <div class="k-card__body"><div class="k-card__title">{{ collection.title }}</div></div>
        </a>
      {% endunless %}
    {% endfor %}
  </div>
</section>

{% schema %}
{ "name": "Liste des collections" }
{% endschema %}
