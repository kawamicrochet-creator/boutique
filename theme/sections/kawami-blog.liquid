<section class="k-container" style="padding: 44px 40px 60px">
  <h1 class="k-h1">{{ blog.title }}</h1>
  <div class="k-grid k-grid-3">
    {% for article in blog.articles %}
      <a href="{{ article.url }}" class="k-card">
        <div class="k-card__media" style="aspect-ratio: 4/3">{% if article.image %}<img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}" loading="lazy">{% endif %}</div>
        <div class="k-card__body">
          <div class="k-card__title">{{ article.title }}</div>
          <div class="k-card__subtitle">{{ article.published_at | date: '%d %B %Y' }}</div>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
