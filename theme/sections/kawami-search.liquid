<section class="k-container" style="padding: 44px 40px 60px">
  <h1 class="k-h1">Résultats de recherche</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="margin: 0 0 30px; display: flex; gap: 10px; max-width: 420px">
    <input type="search" name="q" class="k-field" value="{{ search.terms | escape }}" placeholder="Rechercher une peluche…">
    <button type="submit" class="k-btn k-btn-primary">OK</button>
  </form>
  {% if search.performed %}
    {% if search.results_count > 0 %}
      <div class="k-grid k-grid-4">
        {% for item in search.results %}
          <a href="{{ item.url }}" class="k-card">
            <div class="k-card__media">{% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.title }}" loading="lazy">{% endif %}</div>
            <div class="k-card__body">
              <div class="k-card__title">{{ item.title }}</div>
              {% if item.price %}<div style="font: 700 13px var(--k-font-ui); color: var(--k-primary); margin-top: 4px">{{ item.price | money }}</div>{% endif %}
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <p style="font: 600 14px var(--k-font-ui); color: var(--k-text-soft)">Aucun résultat pour « {{ search.terms }} ».</p>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{ "name": "Recherche" }
{% endschema %}
