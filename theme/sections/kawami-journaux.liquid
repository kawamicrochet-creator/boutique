{% liquid
  assign shop_collection = section.settings.nav_shop_collection
  assign purchase_page = section.settings.purchase_page
  assign contact_page = section.settings.contact_page
%}

<section class="k-container" style="padding: 44px 40px 0">
  <div class="k-breadcrumb">
    <a href="{{ routes.root_url }}">Accueil</a> <span style="opacity: .5">›</span>
    <a href="{% if shop_collection %}{{ shop_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Boutique</a> <span style="opacity: .5">›</span>
    {{ page.title | default: 'Journaux' }}
  </div>
</section>

<section class="k-container" style="padding: 0 40px 30px">
  <div class="k-journal-hero" style="position: relative; height: 540px; border-radius: 30px; overflow: hidden; border: 10px solid #fff; box-shadow: 0 18px 44px rgba(92,67,81,.16)">
    {% if section.settings.hero_image %}
      <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" alt="{{ section.settings.title | escape }}" width="1600" height="540" style="display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 40%">
    {% else %}
      <div style="width: 100%; height: 100%; background: var(--k-pink-soft)"></div>
    {% endif %}
    <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(52,36,44,.85), rgba(52,36,44,.6) 45%, rgba(52,36,44,.2) 70%, transparent)"></div>
    <div class="k-journal-hero__overlay" style="position: absolute; left: 0; top: 0; bottom: 0; max-width: 600px; padding: 0 8%; display: flex; flex-direction: column; justify-content: center; gap: 14px">
      <div style="display: inline-flex; align-self: flex-start; align-items: center; gap: 8px; background: rgba(253,243,244,.92); border-radius: 999px; padding: 7px 16px; font: 700 11px var(--k-font-ui); letter-spacing: .18em; color: #c76b88; text-transform: uppercase">{{ section.settings.eyebrow | default: "🌸 À venir prochainement" }}</div>
      <h1 class="k-journal-hero__title" style="font: 900 46px/1.16 var(--k-font-title); color: #fff; margin: 0; text-wrap: pretty; text-shadow: 0 2px 14px rgba(0,0,0,.35)">{{ section.settings.title | default: "Esprits Divergents" }}</h1>
      <div class="k-italic-accent k-journal-hero__subtitle" style="font-size: 21px; color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,.35)">{{ section.settings.subtitle | default: "une collection de journaux doux, bientôt chez toi 🌸" }}</div>
      <p style="font: 500 14px/1.6 var(--k-font-ui); color: #fff; margin: 0; max-width: 460px; text-shadow: 0 1px 8px rgba(0,0,0,.3)">{{ section.settings.text }}</p>
    </div>
  </div>
</section>

<section class="k-container" style="padding: 20px 40px 10px">
  <div style="text-align: center; max-width: 640px; margin: 0 auto 26px">
    <h2 style="font: 900 30px var(--k-font-title); color: var(--k-text); margin: 0 0 10px">{{ section.settings.benefits_title | default: "Pourquoi tenir un journal ? ✿" }}</h2>
    <p style="font: 500 14px/1.7 var(--k-font-ui); color: var(--k-text-soft); margin: 0">{{ section.settings.benefits_text }}</p>
  </div>
  <div class="k-grid k-grid-4" style="align-items: stretch">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 20px; padding: 22px 20px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center" {{ block.shopify_attributes }}>
          <div style="width: 52px; height: 52px; margin: 0 auto 12px; border-radius: 50%; background: {{ block.settings.bg }}; display: flex; align-items: center; justify-content: center; font-size: 24px">{{ block.settings.emoji }}</div>
          <div style="font: 700 15px var(--k-font-title); color: var(--k-text); margin-bottom: 5px">{{ block.settings.title }}</div>
          <div style="font: 500 12.5px/1.55 var(--k-font-ui); color: var(--k-text-soft)">{{ block.settings.text }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="k-container" style="padding: 44px 40px 10px">
  <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 6px; flex-wrap: wrap">
    <h2 style="font: 900 26px var(--k-font-title); color: var(--k-text); margin: 0">{{ section.settings.premiers_title | default: "Les tout premiers 🌷" }}</h2>
    <span style="font: 600 13px var(--k-font-ui); color: var(--k-text-muted)">{{ section.settings.premiers_tag | default: "disponibles au lancement" }}</span>
  </div>
  <p style="font: 500 13.5px var(--k-font-ui); color: var(--k-text-soft); margin: 0 0 22px">{{ section.settings.premiers_text }}</p>
  <div class="k-grid k-grid-2" style="align-items: stretch">
    {% for block in section.blocks %}
      {% if block.type == 'journal_preview' %}
        <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 24px; overflow: hidden; display: flex; flex-wrap: wrap" {{ block.shopify_attributes }}>
          <div class="k-journal-card__media" style="width: 44%; min-width: 160px; min-height: 240px; flex: none; position: relative; background: var(--k-beige)">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" width="500" height="625" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover" loading="lazy">
            {% endif %}
            {% if block.settings.badge_label != blank %}
              <div style="position: absolute; top: 12px; left: 12px; font: 700 10px var(--k-font-ui); letter-spacing: .05em; color: #5b4479; background: var(--k-lavender); padding: 5px 10px; border-radius: 999px">{{ block.settings.badge_label }}</div>
            {% endif %}
          </div>
          <div style="flex: 1; min-width: 200px; padding: 22px 22px 20px; display: flex; flex-direction: column">
            <div style="font: 700 19px var(--k-font-title); color: var(--k-text)">{{ block.settings.name }}</div>
            <div style="font: 500 12px var(--k-font-ui); color: var(--k-text-muted); margin: 3px 0 10px">{{ block.settings.subtitle }}</div>
            <div style="font: 500 13px/1.6 var(--k-font-ui); color: var(--k-text-soft); margin-bottom: 16px">{{ block.settings.description }}</div>
            <a href="{% if block.settings.product %}{{ block.settings.product.url }}{% elsif purchase_page %}{{ purchase_page.url }}{% else %}#{% endif %}" class="k-btn k-btn-primary" style="margin-top: auto; text-align: center">{{ section.settings.premiers_cta_text | default: "Bientôt disponible" }}</a>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="k-container" style="padding: 40px 40px 10px">
  <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; flex-wrap: wrap">
    <h2 style="font: 900 26px var(--k-font-title); color: var(--k-text); margin: 0">{{ section.settings.avenir_title | default: "Et bientôt d'autres… 💫" }}</h2>
    <span style="font: 600 13px var(--k-font-ui); color: var(--k-text-muted)">{{ section.settings.avenir_tag | default: "en préparation dans l'atelier" }}</span>
  </div>
  <div class="k-grid k-grid-2">
    {% for block in section.blocks %}
      {% if block.type == 'coming_soon' %}
        <div style="background: var(--k-card); border: 1.5px dashed #e6c6d2; border-radius: 22px; padding: 22px 24px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap" {{ block.shopify_attributes }}>
          <div style="width: 56px; height: 56px; flex: none; border-radius: 16px; background: {{ block.settings.bg }}; display: flex; align-items: center; justify-content: center; font-size: 26px">{{ block.settings.emoji }}</div>
          <div style="flex: 1; min-width: 160px">
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap">
              <span style="font: 700 17px var(--k-font-title); color: var(--k-text)">{{ block.settings.name }}</span>
              <span style="font: 700 9.5px var(--k-font-ui); letter-spacing: .06em; color: var(--k-beige-darker); background: var(--k-beige); padding: 3px 9px; border-radius: 999px; text-transform: uppercase">À venir</span>
            </div>
            <div style="font: 500 12.5px/1.55 var(--k-font-ui); color: var(--k-text-soft); margin-top: 4px">{{ block.settings.text }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="k-container k-split" style="padding: 40px 40px 6px; display: grid; grid-template-columns: 1.1fr .9fr; gap: 30px; align-items: center">
  <div style="border-radius: 28px; overflow: hidden; border: 1.5px solid var(--k-border); box-shadow: 0 14px 40px rgba(92,67,81,.14)">
    {% if section.settings.feature_image %}
      <img src="{{ section.settings.feature_image | image_url: width: 1200 }}" alt="{{ section.settings.feature_title | escape }}" width="1200" height="900" style="display: block; width: 100%; height: auto" loading="lazy">
    {% else %}
      <div style="width: 100%; aspect-ratio: 4/3; background: var(--k-pink-soft)"></div>
    {% endif %}
  </div>
  <div style="display: flex; flex-direction: column; gap: 16px">
    <div style="font: 700 11px var(--k-font-ui); letter-spacing: .2em; color: var(--k-text-muted); text-transform: uppercase">{{ section.settings.feature_eyebrow | default: "📱 Numérique & 📖 papier" }}</div>
    <h2 style="font: 900 27px/1.2 var(--k-font-title); color: var(--k-text); margin: 0; text-wrap: pretty">{{ section.settings.feature_title | default: "Sur ta tablette, à imprimer ou en joli livret" }}</h2>
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 18px; padding: 18px 22px; display: flex; gap: 12px; align-items: center">
      <span style="font-size: 22px; flex: none">{{ section.settings.feature_1_emoji | default: "📱" }}</span>
      <span style="font: 600 13.5px/1.5 var(--k-font-ui); color: var(--k-text)">{{ section.settings.feature_1_text | default: "Version numérique interactive — Notability / GoodNotes" }}</span>
    </div>
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 18px; padding: 18px 22px; display: flex; gap: 12px; align-items: center">
      <span style="font-size: 22px; flex: none">{{ section.settings.feature_2_emoji | default: "📖" }}</span>
      <span style="font: 600 13.5px/1.5 var(--k-font-ui); color: var(--k-text)">{{ section.settings.feature_2_text | default: "Format livret A5 — à imprimer ou en édition papier à couverture rigide" }}</span>
    </div>
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 18px; padding: 18px 22px; display: flex; gap: 12px; align-items: center">
      <span style="font-size: 22px; flex: none">{{ section.settings.feature_3_emoji | default: "📄" }}</span>
      <span style="font: 600 13.5px/1.5 var(--k-font-ui); color: var(--k-text)">{{ section.settings.feature_3_text | default: "Fichier PDF à imprimer — incluant les formats A4 et Lettre (US)" }}</span>
    </div>
  </div>
</section>

<section class="k-container" style="padding: 44px 40px 10px">
  <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 6px; flex-wrap: wrap">
    <h2 style="font: 900 26px var(--k-font-title); color: var(--k-text); margin: 0">{{ section.settings.goodies_title | default: "À assortir avec des goodies 🪡" }}</h2>
  </div>
  <p style="font: 500 13.5px var(--k-font-ui); color: var(--k-text-soft); margin: 0 0 22px">{{ section.settings.goodies_text }}</p>
  <div class="k-grid k-grid-3">
    {% for block in section.blocks %}
      {% if block.type == 'goodie' %}
        <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 22px; padding: 24px 22px; text-align: center" {{ block.shopify_attributes }}>
          <div style="width: 56px; height: 56px; margin: 0 auto 12px; border-radius: 50%; background: {{ block.settings.bg }}; display: flex; align-items: center; justify-content: center; font-size: 26px">{{ block.settings.emoji }}</div>
          <div style="font: 700 15px var(--k-font-title); color: var(--k-text); margin-bottom: 4px">{{ block.settings.name }}</div>
          <div style="font: 500 12.5px/1.55 var(--k-font-ui); color: var(--k-text-soft)">{{ block.settings.text }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="k-container" style="padding: 44px 40px 60px">
  <div style="position: relative; border-radius: 28px; padding: 56px 40px; text-align: center; overflow: hidden{% if section.settings.cta_background %}; background: url('{{ section.settings.cta_background | image_url: width: 1600 }}') center 22%/cover{% else %}; background: var(--k-pink-soft){% endif %}">
    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(253,241,244,.62), rgba(253,241,244,.42))"></div>
    <div style="position: relative">
      <div style="font-size: 32px; margin-bottom: 8px">💌</div>
      <h2 style="font: 900 28px var(--k-font-title); color: var(--k-text); margin: 0 0 10px">{{ section.settings.cta_title | default: "Sois au courant du lancement" }}</h2>
      <p style="font: 600 14px/1.6 var(--k-font-ui); color: #7a5566; margin: 0 auto 22px; max-width: 470px">{{ section.settings.cta_text }}</p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap">
        {% if section.settings.show_purchase_button %}
          <a href="{% if purchase_page %}{{ purchase_page.url }}{% else %}#{% endif %}" class="k-btn k-btn-dark">{{ section.settings.purchase_cta_text | default: "Voir les journaux →" }}</a>
        {% endif %}
        <a href="{% if contact_page %}{{ contact_page.url }}{% else %}#{% endif %}" class="k-btn k-btn-secondary" style="background: #fff">{{ section.settings.notify_cta_text | default: "Me prévenir" }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journaux Kawami (bientôt)",
  "settings": [
    { "type": "collection", "id": "nav_shop_collection", "label": "Collection « Boutique » (fil d'ariane)" },
    { "type": "page", "id": "purchase_page", "label": "Page/collection d'achat des journaux", "info": "À relier plus tard, une fois la page d'achat créée." },
    { "type": "page", "id": "contact_page", "label": "Page Contact (bouton « Me prévenir »)" },
    { "type": "header", "content": "Bannière" },
    { "type": "image_picker", "id": "hero_image", "label": "Image bannière" },
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "🌸 À venir prochainement" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Esprits Divergents" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre (italique)", "default": "une collection de journaux doux, bientôt chez toi 🌸" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des carnets pensés pour ralentir, respirer et prendre soin de soi — illustrés dans l'univers tendre de Kawami." },
    { "type": "header", "content": "Pourquoi tenir un journal" },
    { "type": "text", "id": "benefits_title", "label": "Titre", "default": "Pourquoi tenir un journal ? ✿" },
    { "type": "textarea", "id": "benefits_text", "label": "Texte", "default": "Écrire quelques minutes par jour, c'est un petit geste de douceur envers soi. Nos journaux t'accompagnent avec bienveillance, sans pression ni performance." },
    { "type": "header", "content": "Les tout premiers" },
    { "type": "text", "id": "premiers_title", "label": "Titre", "default": "Les tout premiers 🌷" },
    { "type": "text", "id": "premiers_tag", "label": "Petite étiquette", "default": "disponibles au lancement" },
    { "type": "textarea", "id": "premiers_text", "label": "Texte", "default": "Deux carnets pour commencer en douceur — en numérique à imprimer, ou en joli carnet papier." },
    { "type": "text", "id": "premiers_cta_text", "label": "Texte du bouton", "default": "Bientôt disponible" },
    { "type": "header", "content": "Et bientôt d'autres" },
    { "type": "text", "id": "avenir_title", "label": "Titre", "default": "Et bientôt d'autres… 💫" },
    { "type": "text", "id": "avenir_tag", "label": "Petite étiquette", "default": "en préparation dans l'atelier" },
    { "type": "header", "content": "Numérique & papier (image + 3 points)" },
    { "type": "image_picker", "id": "feature_image", "label": "Image (tablette + livret)" },
    { "type": "text", "id": "feature_eyebrow", "label": "Petit texte", "default": "📱 Numérique & 📖 papier" },
    { "type": "text", "id": "feature_title", "label": "Titre", "default": "Sur ta tablette, à imprimer ou en joli livret" },
    { "type": "text", "id": "feature_1_emoji", "label": "Point 1 — émoji", "default": "📱" },
    { "type": "text", "id": "feature_1_text", "label": "Point 1 — texte", "default": "Version numérique interactive — Notability / GoodNotes" },
    { "type": "text", "id": "feature_2_emoji", "label": "Point 2 — émoji", "default": "📖" },
    { "type": "text", "id": "feature_2_text", "label": "Point 2 — texte", "default": "Format livret A5 — à imprimer ou en édition papier à couverture rigide" },
    { "type": "text", "id": "feature_3_emoji", "label": "Point 3 — émoji", "default": "📄" },
    { "type": "text", "id": "feature_3_text", "label": "Point 3 — texte", "default": "Fichier PDF à imprimer — incluant les formats A4 et Lettre (US)" },
    { "type": "header", "content": "Goodies" },
    { "type": "text", "id": "goodies_title", "label": "Titre", "default": "À assortir avec des goodies 🪡" },
    { "type": "textarea", "id": "goodies_text", "label": "Texte", "default": "Pour prendre soin de tes carnets et de tes livres, des petits accessoires en tissu fleuri, à venir aussi." },
    { "type": "header", "content": "Bandeau final" },
    { "type": "image_picker", "id": "cta_background", "label": "Photo de fond" },
    { "type": "text", "id": "cta_title", "label": "Titre", "default": "Sois au courant du lancement" },
    { "type": "textarea", "id": "cta_text", "label": "Texte", "default": "Inscris-toi à la petite lettre de l'atelier : tu sauras dès que les premiers journaux seront disponibles (et tu recevras des pages bonus à imprimer 🎁)." },
    { "type": "checkbox", "id": "show_purchase_button", "label": "Afficher le bouton « Voir les journaux »", "default": false, "info": "À activer une fois la page d'achat prête." },
    { "type": "text", "id": "purchase_cta_text", "label": "Texte bouton « achat »", "default": "Voir les journaux →" },
    { "type": "text", "id": "notify_cta_text", "label": "Texte bouton « contact »", "default": "Me prévenir" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Émoji", "default": "🌿" },
        { "type": "color", "id": "bg", "label": "Fond du rond", "default": "#bfe3d2" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Apaiser le mental" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Poser ses pensées sur le papier libère la tête et calme les journées agitées." }
      ]
    },
    {
      "type": "journal_preview",
      "name": "Journal (à venir)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Visuel (mockup tablette/livret)" },
        { "type": "text", "id": "badge_label", "label": "Badge", "default": "Bientôt" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Mon Journal de Gratitude" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "cultiver la gratitude, enrichir chaque jour" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Chaque jour, quelques lignes pour cultiver la douceur : humeur, gratitude et petites victoires, guidé par de tendres illustrations." },
        { "type": "product", "id": "product", "label": "Produit lié (optionnel, remplace le lien de la page d'achat)" }
      ]
    },
    {
      "type": "coming_soon",
      "name": "Bientôt en préparation",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Émoji", "default": "🫧" },
        { "type": "color", "id": "bg", "label": "Fond de l'icône", "default": "#d5c3e8" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Journal d'anxiété" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Un carnet doux pour accueillir ses émotions, repérer ses déclencheurs et respirer." }
      ]
    },
    {
      "type": "goodie",
      "name": "Goodie",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Émoji", "default": "🔖" },
        { "type": "color", "id": "bg", "label": "Fond du rond", "default": "#f8cdd8" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Repère-pages" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "marque-pages en tissu fleuri, cousus main." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journaux Kawami (bientôt)",
      "blocks": [
        { "type": "benefit", "settings": { "emoji": "🌿", "bg": "#bfe3d2", "title": "Apaiser le mental", "text": "Poser ses pensées sur le papier libère la tête et calme les journées agitées." } },
        { "type": "benefit", "settings": { "emoji": "💗", "bg": "#f8cdd8", "title": "Cultiver la gratitude", "text": "Noter une petite joie chaque jour aide à voir le beau, même les jours gris." } },
        { "type": "benefit", "settings": { "emoji": "📚", "bg": "#d5c3e8", "title": "Garder une trace", "text": "Tes lectures, tes projets, tes envies — tout au même endroit, joliment." } },
        { "type": "benefit", "settings": { "emoji": "🌸", "bg": "#fce3c8", "title": "Un moment pour soi", "text": "Un rituel doux, sans pression, rien qu'à toi. Du self-care en quelques minutes." } },
