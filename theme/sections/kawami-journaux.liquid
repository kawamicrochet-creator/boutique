{% liquid
  assign shop_collection = section.settings.nav_shop_collection
%}
<section class="k-container" style="padding-top: 44px; padding-bottom: 8px">
  <div class="k-breadcrumb">
    <a href="{{ routes.root_url }}">Accueil</a> <span style="opacity: .5">›</span>
    <a href="{% if shop_collection %}{{ shop_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Boutique</a> <span style="opacity: .5">›</span>
    {{ page.title | default: 'Journaux' }}
  </div>
  <div style="display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap">
    <h1 class="k-h1">{{ section.settings.title | default: "Esprits Divergents 📖" }}</h1>
    <span class="k-italic-accent" style="font-size: 17px; color: var(--k-beige-deep)">{{ section.settings.subtitle }}</span>
  </div>
  <p class="k-lead" style="margin: 6px 0 24px; max-width: 600px">{{ section.settings.intro }}</p>
</section>

{% if section.settings.hero_image %}
<section class="k-container" style="padding-bottom: 26px">
  <div style="position: relative; border-radius: 30px; overflow: hidden; border: 10px solid #fff; box-shadow: 0 18px 44px rgba(92, 67, 81, .16)">
    <img
      src="{{ section.settings.hero_image | image_url: width: 1600 }}"
      alt="{{ section.settings.hero_title | escape }}"
      style="display: block; width: 100%; height: 520px; object-fit: cover; object-position: center 62%"
      loading="lazy"
    >
    <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(92,67,81,.5), rgba(92,67,81,.12) 55%, transparent)"></div>
    <div style="position: absolute; left: 0; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: center; gap: 12px; padding: 0 8%; max-width: 560px">
      <div style="font: 700 11px var(--k-font-ui); letter-spacing: .24em; color: #fbe9ee; text-transform: uppercase">✿ {{ section.settings.hero_eyebrow | default: "Journaling doux" }} ✿</div>
      <div style="font: 900 40px/1.18 var(--k-font-title); color: #fff; text-wrap: pretty">{{ section.settings.hero_title | default: "Écris ta douceur, une page à la fois" }}</div>
      <div class="k-italic-accent" style="font-size: 20px; color: #fbe9ee">{{ section.settings.hero_subtitle | default: "un petit rituel rien qu'à toi 🌸" }}</div>
    </div>
  </div>
</section>
{% endif %}

<section class="k-container" style="padding-bottom: 20px">
  <div class="k-grid k-grid-3">
    {% for block in section.blocks %}
      {% if block.type == 'journal' %}
        <div class="k-card" {{ block.shopify_attributes }}>
          <div class="k-card__media" style="aspect-ratio: 4/5">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" loading="lazy">
            {% endif %}
            {% if block.settings.badge_label != blank %}
              <div class="k-card__badge" style="color: {{ block.settings.badge_fg }}; background: {{ block.settings.badge_bg }}; font: 700 10.5px var(--k-font-ui); letter-spacing: .05em; padding: 5px 11px; border-radius: 999px">{{ block.settings.badge_label }}</div>
            {% endif %}
          </div>
          <div style="padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 5px; flex: 1">
            <div style="font: 700 17px var(--k-font-title); color: var(--k-text)">{{ block.settings.name }}</div>
            <div style="font: 500 12px var(--k-font-ui); color: var(--k-text-muted)">{{ block.settings.subtitle }}</div>
            <div style="font: 500 12.5px/1.55 var(--k-font-ui); color: var(--k-text-soft); margin: 4px 0 12px">{{ block.settings.description }}</div>
            <div style="margin-top: auto; display: flex; flex-direction: column; gap: 8px">
              <div style="display: flex; align-items: center; justify-content: space-between; background: var(--k-bg); border: 1.5px solid var(--k-border); border-radius: 14px; padding: 10px 14px">
                <div style="display: flex; flex-direction: column">
                  <span style="font: 700 12.5px var(--k-font-ui); color: var(--k-text)">⬇️ Numérique (PDF)</span>
                  <span style="font: 500 10.5px var(--k-font-ui); color: var(--k-text-muted)">téléchargement immédiat</span>
                </div>
                <span style="font: 700 14px var(--k-font-ui); color: var(--k-primary)">{{ block.settings.digital_price | money }}</span>
              </div>
              <div style="display: flex; align-items: center; justify-content: space-between; background: var(--k-bg); border: 1.5px solid var(--k-border); border-radius: 14px; padding: 10px 14px">
                <div style="display: flex; flex-direction: column">
                  <span style="font: 700 12.5px var(--k-font-ui); color: var(--k-text)">📦 Papier</span>
                  <span style="font: 500 10.5px var(--k-font-ui); color: var(--k-text-muted)">carnet imprimé, posté</span>
                </div>
                <span style="font: 700 14px var(--k-font-ui); color: var(--k-primary)">{{ block.settings.paper_price | money }}</span>
              </div>
              <a
                href="{% if block.settings.product %}{{ block.settings.product.url }}{% else %}{{ routes.cart_url }}{% endif %}"
                class="k-btn k-btn-primary"
                style="margin-top: 2px"
              >{% if block.settings.product %}Voir les options{% else %}Ajouter au panier{% endif %}</a>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="k-container" style="padding: 34px 40px 10px">
  <div class="k-grid k-grid-2">
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 22px; padding: 24px 26px">
      <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--k-lavender); display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 12px">⬇️</div>
      <div style="font: 700 16px var(--k-font-title); color: var(--k-text); margin-bottom: 6px">Version numérique</div>
      <div style="font: 500 13px/1.6 var(--k-font-ui); color: var(--k-text-soft)">Un fichier PDF haute qualité reçu par email juste après l'achat. À imprimer chez toi autant de fois que tu veux, format A4 ou A5. Parfait tout de suite, sans attendre la livraison 💫</div>
    </div>
    <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 22px; padding: 24px 26px">
      <div style="width: 44px; height: 44px; border-radius: 50%; background: var(--k-mint); display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 12px">📦</div>
      <div style="font: 700 16px var(--k-font-title); color: var(--k-text); margin-bottom: 6px">Version papier</div>
      <div style="font: 500 13px/1.6 var(--k-font-ui); color: var(--k-text-soft)">Un vrai carnet imprimé avec soin, couverture souple et papier crème, posté chez toi bien emballé. Expédié sous 3-5 jours ouvrés dans le monde entier 🌸</div>
    </div>
  </div>
</section>

<section class="k-container" style="padding: 34px 40px 60px">
  <div class="k-callout">
    <div class="k-callout__icon">💌</div>
    <div style="flex: 1; min-width: 260px">
      <div class="k-callout__title">De nouveaux journaux arrivent</div>
      <div class="k-callout__text">Inscris-toi à la petite lettre de l'atelier pour être prévenue des prochaines sorties (et recevoir des pages bonus à imprimer 🎁).</div>
    </div>
    {% form 'customer', class: 'k-newsletter-form', style: 'display:flex;gap:10px' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" class="k-input" placeholder="ton@email.fr" required style="min-width: 220px">
      <button type="submit" class="k-btn k-btn-dark">S'inscrire</button>
      {% if form.posted_successfully? %}<div style="font: 600 12px var(--k-font-ui); color: var(--k-text)">Merci, c'est noté 🌸</div>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Journaux Kawami",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Esprits Divergents 📖" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre (italique)", "default": "à télécharger ou en version papier" },
    { "type": "textarea", "id": "intro", "label": "Texte d'intro", "default": "Des carnets doux et illustrés pour noter tes projets crochet, tes envies kawaii et tes petites victoires. Choisis la version numérique (à imprimer chez toi, tout de suite) ou le joli carnet papier posté à la maison 🌸" },
    { "type": "image_picker", "id": "hero_image", "label": "Image bannière" },
    { "type": "text", "id": "hero_eyebrow", "label": "Bannière — petit texte", "default": "Journaling doux" },
    { "type": "text", "id": "hero_title", "label": "Bannière — titre", "default": "Écris ta douceur, une page à la fois" },
    { "type": "text", "id": "hero_subtitle", "label": "Bannière — sous-titre italique", "default": "un petit rituel rien qu'à toi 🌸" },
    { "type": "collection", "id": "nav_shop_collection", "label": "Collection « Boutique » (fil d'ariane)" }
  ],
  "blocks": [
    {
      "type": "journal",
      "name": "Journal",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom", "default": "Carnet de projets crochet" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "120 pages · pointillés + suivi de projets" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge_label", "label": "Badge", "default": "2 formats" },
        { "type": "color", "id": "badge_bg", "label": "Badge — fond", "default": "#bfe3d2" },
        { "type": "color", "id": "badge_fg", "label": "Badge — texte", "default": "#3f6b56" },
        { "type": "number", "id": "digital_price", "label": "Prix numérique (PDF), en centimes", "default": 800 },
        { "type": "number", "id": "paper_price", "label": "Prix papier, en centimes", "default": 1800 },
        { "type": "product", "id": "product", "label": "Produit lié (optionnel — pour un vrai bouton d'achat)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journaux Kawami",
      "blocks": [
        {
          "type": "journal",
          "settings": {
            "name": "Carnet de projets crochet",
            "subtitle": "120 pages · pointillés + suivi de projets",
            "description": "Note tes modèles, tes laines, ton avancement et tes idées, avec des pages illustrées kawaii.",
            "badge_label": "2 formats",
            "digital_price": 800,
            "paper_price": 1800
          }
        },
        {
          "type": "journal",
          "settings": {
            "name": "Journal quotidien Sakura",
            "subtitle": "90 jours · gratitude & humeur",
            "description": "Un petit rituel doux chaque jour : humeur, gratitude, une victoire. Ambiance pastel apaisante.",
            "badge_label": "2 formats",
            "digital_price": 700,
            "paper_price": 1600
          }
        },
        {
          "type": "journal",
          "settings": {
            "name": "Planner kawaii de la semaine",
            "subtitle": "52 semaines · à imprimer ou relié",
            "description": "Organise ta semaine avec douceur : to-do, repas, self-care et stickers à découper.",
            "badge_label": "Numérique + papier",
            "digital_price": 600,
            "paper_price": 1500
          }
        }
      ]
    }
  ]
}
{% endschema %}
