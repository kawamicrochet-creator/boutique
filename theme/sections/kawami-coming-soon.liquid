<section style="max-width: 1080px; margin: 0 auto; padding: 60px 40px 30px; text-align: center">
  <div class="k-eyebrow" style="margin-bottom: 20px">{{ section.settings.eyebrow | default: "🌸 Bientôt disponible" }}</div>
  <h1 style="font: 900 46px/1.18 var(--k-font-title); color: var(--k-text); margin: 0 0 16px; text-wrap: pretty">{{ section.settings.title }}<br><span class="k-italic-accent" style="color: var(--k-beige-deep); font-size: 46px">{{ section.settings.title_accent }}</span></h1>
  <p class="k-lead" style="font-size: 16px; margin: 0 auto 30px; max-width: 560px">{{ section.settings.text }}</p>
</section>

{% if section.settings.image %}
<section style="max-width: 1080px; margin: 0 auto; padding: 0 40px 20px">
  <div style="position: relative; border-radius: 30px; overflow: hidden; border: 10px solid #fff; box-shadow: 0 20px 50px rgba(92,67,81,.18)">
    <img src="{{ section.settings.image | image_url: width: 1600 }}" style="display: block; width: 100%; height: 520px; object-fit: cover" alt="">
    {% if section.settings.tag_text != blank %}
      <div style="position: absolute; left: 22px; bottom: 22px; background: rgba(253,243,244,.92); border: 1.5px solid var(--k-pink); border-radius: 999px; padding: 10px 20px; box-shadow: 0 6px 16px rgba(92,67,81,.14)" class="k-italic-accent">
        <span style="color: var(--k-beige-darker); font-size: 15px">{{ section.settings.tag_text }}</span>
      </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section style="max-width: 1080px; margin: 0 auto; padding: 34px 40px 10px">
  <div class="k-grid k-grid-4">
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        <div style="background: var(--k-card); border: 1.5px solid var(--k-border); border-radius: 20px; padding: 22px 18px; text-align: center" {{ block.shopify_attributes }}>
          <div style="font-size: 26px; margin-bottom: 8px">{{ block.settings.icon }}</div>
          <div style="font: 700 14px var(--k-font-title); color: var(--k-text)">{{ block.settings.name }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section style="max-width: 1080px; margin: 0 auto; padding: 44px 40px 64px">
  <div style="position: relative; background: var(--k-pink-soft); border-radius: 28px; overflow: hidden; padding: 48px 40px; text-align: center">
    <div class="k-anim-twinkle" style="position: absolute; left: 34px; top: 26px; font-size: 22px">✨</div>
    <div class="k-anim-twinkle" style="position: absolute; right: 40px; bottom: 30px; font-size: 20px; animation-delay: 1s">🌸</div>
    <div style="font-size: 32px; margin-bottom: 8px">💌</div>
    <h2 style="font: 900 28px var(--k-font-title); color: var(--k-text); margin: 0 0 10px">{{ section.settings.newsletter_title | default: "Sois la première prévenue du lancement" }}</h2>
    <p style="font: 500 14.5px/1.6 var(--k-font-ui); color: #8a5f70; margin: 0 auto 24px; max-width: 460px">{{ section.settings.newsletter_text }}</p>
    {% form 'customer', class: 'k-newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="k-form-row" style="display: flex; gap: 10px; max-width: 440px; margin: 0 auto">
        <input type="email" name="contact[email]" class="k-input" style="flex: 1" placeholder="ton@email.fr" required>
        <button type="submit" class="k-btn k-btn-dark">Me prévenir</button>
      </div>
      {% if form.posted_successfully? %}<p style="font: 600 12px var(--k-font-ui); color: var(--k-text); margin-top: 10px">Merci, c'est noté 🌸</p>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Bientôt disponible",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "🌸 Bientôt disponible" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Les accessoires cousus main" },
    { "type": "text", "id": "title_accent", "label": "Titre (accent italique)", "default": "arrivent bientôt" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Trousses de toilette, housses pour livres et ordinateurs, totes bags matelassés — des accessoires aux tissus fleuris et romantiques, cousus à la main en petite série. La collection se prépare dans l'atelier 🪡" },
    { "type": "image_picker", "id": "image", "label": "Image centrale" },
    { "type": "text", "id": "tag_text", "label": "Étiquette sur l'image", "default": "cousu main, en petite série 🪡" },
    { "type": "text", "id": "newsletter_title", "label": "Titre newsletter", "default": "Sois la première prévenue du lancement" },
    { "type": "textarea", "id": "newsletter_text", "label": "Texte newsletter", "default": "Inscris-toi à la petite lettre de l'atelier : tu sauras dès que la collection d'accessoires sera en ligne (promis, pas de spam — juste de la douceur)." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        { "type": "text", "id": "icon", "label": "Émoji", "default": "🌷" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Trousses de toilette" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bientôt disponible",
      "blocks": [
        { "type": "category", "settings": { "icon": "🌷", "name": "Trousses de toilette" } },
        { "type": "category", "settings": { "icon": "📚", "name": "Housses de livre" } },
        { "type": "category", "settings": { "icon": "💻", "name": "Housses d'ordinateur" } },
        { "type": "category", "settings": { "icon": "👜", "name": "Totes bags matelassés" } }
      ]
    }
  ]
}
{% endschema %}
